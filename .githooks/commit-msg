#!/usr/bin/env bash
# Enforces Conventional Commits (https://www.conventionalcommits.org/)
# locally, as a fast complement to the commitlint CI check on PRs.
# Enable with: git config core.hooksPath .githooks
set -euo pipefail

commit_msg_file="$1"
first_line=$(head -n1 "$commit_msg_file")

# Allow merge commits and fixup!/squash! commits through untouched.
if [[ "$first_line" =~ ^Merge\  ]] || [[ "$first_line" =~ ^(fixup|squash)! ]]; then
  exit 0
fi

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9./_-]+\))?!?: .{1,}$'

if ! [[ "$first_line" =~ $pattern ]]; then
  echo "error: commit message does not follow Conventional Commits format" >&2
  echo "  expected: <type>(<optional scope>): <description>" >&2
  echo "  types:    feat fix docs style refactor perf test build ci chore revert" >&2
  echo "  e.g.:     feat(cli): add --debug flag" >&2
  echo "  got:      $first_line" >&2
  exit 1
fi
